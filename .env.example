# =============================================================================
# Cookie Bite — Environment Variables Template
# =============================================================================
# Copy to `.env.local` (dev) or `.env` as needed. NEVER commit a file with
# real values — only this template (`.env.example`) is tracked in git.
#
# Naming rule: any variable prefixed `NEXT_PUBLIC_` is inlined into the
# browser JS bundle by Next.js at build time. Never put a secret, API key,
# or credential behind a `NEXT_PUBLIC_` name — only values that are safe for
# any site visitor to read (public URLs, publishable/public keys, feature
# flags for the UI).
# =============================================================================

# -----------------------------------------------------------------------------
# App / General
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public site URL (client + server). Must be the real production domain in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side canonical base URL (falls back to NEXT_PUBLIC_APP_URL if unset)
APP_BASE_URL=http://localhost:3000
# Locks middleware host/HTTPS redirects to this apex domain in production
COOKIE_BITE_PRIMARY_DOMAIN=cookie-bite.com
# Fail the server boot in production if a required var below is missing
COOKIE_BITE_FAIL_ON_MISSING_ENV=false

# -----------------------------------------------------------------------------
# Supabase (Auth + Database) — https://app.supabase.com/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# -----------------------------------------------------------------------------
# RBAC bootstrap (server only — used to assign the first owner/admin/staff)
# -----------------------------------------------------------------------------
OWNER_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_EMAILS=
STAFF_BOOTSTRAP_EMAILS=

# -----------------------------------------------------------------------------
# Paymob (Payments) — https://accept.paymob.com
# SECURITY: these must stay server-only. Never use a NEXT_PUBLIC_ alias for
# any of these — PAYMOB_SECRET_KEY/API_KEY authenticate server-to-server API
# calls, and PAYMOB_HMAC_SECRET verifies webhook authenticity. If either were
# ever exposed to the browser, an attacker could forge "payment succeeded"
# callbacks or call the Paymob API as your store.
# -----------------------------------------------------------------------------
PAYMOB_SECRET_KEY=
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
# Optional — defaults to https://accept.paymob.com
PAYMOB_API_URL=

# -----------------------------------------------------------------------------
# Cloudinary (media storage / image + video uploads)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Sanity (blog / marketing CMS)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Verifies inbound Sanity webhook signatures — server only
SANITY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email — Resend is primary; the rest are optional alternate providers
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@example.com
RESEND_DOMAIN=
RESEND_REPLY_TO=
RESEND_AUDIENCE_ID=
RESEND_SEGMENT_ID=
RESEND_REGION_HOST=
RESEND_CONTACTS_ENABLED=false
CONTACT_INBOX=
STORE_OPS_EMAIL=
ADMIN_ALERT_EMAIL=
EMAIL_AUTOMATION_ENABLED=true
EMAIL_USE_QUEUE=false
EMAIL_USE_DB_QUEUE=false
EMAIL_PROVIDER_PRIORITY=resend
# Encrypts stored SMTP/provider credentials in the DB-backed email settings UI
EMAIL_CONFIG_ENCRYPTION_KEY=
NEXT_PUBLIC_EMAIL_LOGO_URL=

# Optional alternate providers (only needed if selected in admin email settings)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=
AWS_SES_FROM_EMAIL=

# -----------------------------------------------------------------------------
# AI — Mr. Brownie (storefront) + Mrs. Cookie (admin copilot)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
MR_BROWNIE_GEMINI_MODEL=gemini-flash-latest
MR_BROWNIE_EMBED_MODEL=
MR_BROWNIE_LLM_PROVIDER=gemini
MR_BROWNIE_ENABLE_COACH=false
MR_BROWNIE_DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_INSIGHTS_MODEL=
GEMINI_IMAGE_GENERATION_API_KEY=
GEMINI_IMAGE_GENERATION_MODEL=
GEMINI_IMAGE_GENERATION_PROJECT_ID=
PRODUCT_IMAGE_GEMINI_MODEL=
GOOGLE_CLOUD_PROJECT=

# -----------------------------------------------------------------------------
# WhatsApp notifications (Cloud API + optional self-hosted bridge)
# -----------------------------------------------------------------------------
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMED=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Only needed if running services/whatsapp-bridge
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_PORT=
WHATSAPP_BRIDGE_SECRET=

# -----------------------------------------------------------------------------
# Tracking / Analytics
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_TRACKING_TOKEN=
TRACKING_TOKEN=
NEXT_PUBLIC_DISABLE_TRACKING=false
NEXT_PUBLIC_TRACKING_ENABLE_REPLAY=false
INSTAGRAM_FEED_POST_URLS=

# -----------------------------------------------------------------------------
# Internal / security secrets (server only)
# -----------------------------------------------------------------------------
# Shared secret required on `x-internal-secret` header for server-to-server
# routes (cron, notification triggers, internal push send, etc.)
INTERNAL_API_SECRET=
# Shared secret required to call POST/GET /api/revalidate
REVALIDATE_SECRET=

# -----------------------------------------------------------------------------
# Background workers / queues
# -----------------------------------------------------------------------------
BACKGROUND_WORKERS_ENABLED=true
BACKGROUND_WORKERS_LOOPBACK=
BACKGROUND_WORKER_EMAIL_MS=
BACKGROUND_WORKER_EMAIL_LIMIT=
BACKGROUND_WORKER_NOTIFICATION_MS=
BACKGROUND_WORKER_NOTIFICATION_LIMIT=
BACKGROUND_WORKER_ABANDONED_MS=
BACKGROUND_WORKER_ABANDONED_LIMIT=
BACKGROUND_WORKER_HEALTH_MS=
BACKGROUND_WORKER_HEALTH_LIMIT=
BACKGROUND_WORKER_CATALOG_MS=
BACKGROUND_WORKER_BOOTSTRAP_MS=
BACKGROUND_WORKER_CLOUDINARY_CLEANUP_MS=
# Optional — Redis-backed rate limiting / BullMQ queues (falls back to
# in-memory/DB-backed behavior when unset)
REDIS_URL=

# -----------------------------------------------------------------------------
# Storefront commerce defaults (safe to expose — no secrets)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DELIVERY_FEE_EGP=
NEXT_PUBLIC_FREE_DELIVERY_THRESHOLD_EGP=
NEXT_PUBLIC_EGP_PER_USD=
NEXT_PUBLIC_FORCE_SEASON=

# -----------------------------------------------------------------------------
# Misc integrations
# -----------------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=
# Optional companion Python microservice (recommendations/ML) — see cookie-bite-python/
PYTHON_API_URL=
# Optional — only needed by scripts/hostinger-*.mjs deployment tooling
HOSTINGER_API_TOKEN=

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
COOKIE_BITE_SERVICE_NAME=cookie-bite-web
COOKIE_BITE_CORRELATION_ID=
# HTTPS endpoint that receives a copy of structured error logs (optional)
COOKIE_BITE_LOG_WEBHOOK_URL=
