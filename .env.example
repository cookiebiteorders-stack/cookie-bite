# ───────────────────────────────────────────────────────────────────────────
# Cookie Bite — قالب متغيرات البيئة (بدون أسرار)
# المشروع يستخدم `.env` كمصدر رئيسي للقيم الحقيقية (محلي + بناء Hostinger).
# للتطوير بمفاتيح Clerk test فقط: `.env.local` يغلّب المتغيرات المتعارضة.
# NEVER commit `.env` — انسخ هذا الملف ثم املأ القيم.
# استيراد الإنتاج: npm run hostinger:env-audit → hostinger-production.env
# Production checklist: docs/hostinger-environment-variables.md
# ───────────────────────────────────────────────────────────────────────────

# === App ==================================================================
# The canonical site URL (used by SEO, sitemap, emails, logo asset URL, …).
NEXT_PUBLIC_APP_URL=https://cookie-bite.com
# Server-side absolute URL (webhooks, Paymob redirects, production-lock).
APP_BASE_URL=https://cookie-bite.com
# Optional — enforced host in proxy (default cookie-bite.com).
# COOKIE_BITE_PRIMARY_DOMAIN=cookie-bite.com
# Optional — fail boot if required env keys are missing (see lib/config/production-lock.ts).
# COOKIE_BITE_FAIL_ON_MISSING_ENV=true

# === Google Search Console / OAuth branding verification ==================
# من Search Console → HTML tag → انسخ قيمة content فقط (ليس الوسم كاملاً).
# يظهر في <head> عبر app/layout.tsx — مطلوب لتحقق ملكية https://cookie-bite.com في OAuth Branding.
# GOOGLE_SITE_VERIFICATION=<your-google-site-verification-content>

# === Clerk authentication =================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
CLERK_SECRET_KEY=<your-clerk-secret-key>
# Webhook signing (Svix) — required in production for /api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=<your-clerk-webhook-signing-secret>
# إن فعّلت في Clerk نطاق Frontend API مثل clerk.cookie-bite.com — أضف CNAME في DNS أولاً.
# محلياً: استخدم pk_test_/sk_test_ في .env.local أو اترك fallback التطوير (CDN) يعمل تلقائياً.
# NEXT_PUBLIC_CLERK_JS_URL=https://cdn.jsdelivr.net/npm/@clerk/clerk-js@6/dist/clerk.browser.js

# === Supabase database ====================================================
NEXT_PUBLIC_SUPABASE_URL=<your-supabase-project-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_KEY=<your-supabase-service-key>
# Personal access token — required to run migrations via Management API (NOT the service key).
# Create: https://supabase.com/dashboard/account/tokens
# Then: npm run supabase:ensure-schema
SUPABASE_ACCESS_TOKEN=<your-supabase-personal-access-token>

# === Payments — Paymob (Egypt) ============================================
PAYMOB_API_KEY=<your-paymob-api-key>
# HMAC for payment intention + webhook verification (preferred).
PAYMOB_HMAC_SECRET=<your-paymob-hmac-secret>
# Legacy alias — use only if you cannot rename on Hostinger; prefer PAYMOB_HMAC_SECRET.
# PAYMOB_HMAC=<same-as-secret-or-old-name>
PAYMOB_INTEGRATION_ID_CARD=<paymob-card-integration-id>
PAYMOB_INTEGRATION_ID_WALLET=<paymob-wallet-integration-id>

# === WhatsApp (Meta Cloud API) — optional transactional ===================
# Create app: https://developers.facebook.com/docs/whatsapp/cloud-api
# WHATSAPP_CLOUD_API_TOKEN=<permanent-access-token>
# WHATSAPP_PHONE_NUMBER_ID=<phone-number-id-from-meta>
# WHATSAPP_TEMPLATE_LANGUAGE=ar
# Approved template names (fallback to free text if unset):
# WHATSAPP_TEMPLATE_ORDER_CONFIRMED=cookie_bite_order_confirmed
# WHATSAPP_TEMPLATE_PAYMENT_CONFIRMED=cookie_bite_payment_confirmed

# === WhatsApp Bridge (optional — whatsapp-web.js server) ====================
# Run: cd services/whatsapp-bridge && npm install && npm start
# Scan QR once, then set URL (same secret on bridge + app):
# WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000
# WHATSAPP_BRIDGE_SECRET=<same-as-services/whatsapp-bridge/.env>

# === Notification queue (optional Redis + BullMQ) =========================
# When set, jobs go to Bull; otherwise DB queue + Next.js after().
# REDIS_URL=redis://127.0.0.1:6379
#
# Hostinger cron (every 5 min) when Redis is unset — drains notification_jobs:
#   POST https://cookie-bite.com/api/cron/notification-jobs?limit=20
#   Header: x-internal-secret: <same value as INTERNAL_API_SECRET>
# Generate checklist: npm run hostinger:checklist

# === Email — Resend =======================================================
# Sign up: https://resend.com — create an API key with "Send" permission.
RESEND_API_KEY=<your-resend-api-key>

# Sender that appears in customer inboxes. ALWAYS use a mailbox on the verified
# domain so SPF + DKIM + DMARC pass and emails don't land in spam.
RESEND_FROM_EMAIL="Cookie Bite <cookie-bite@cookie-bite.com>"

# Where replies go when a customer hits "Reply" on a transactional email.
# Defaults to RESEND_FROM_EMAIL mailbox if not set.
RESEND_REPLY_TO=cookie-bite@cookie-bite.com

# Inbox that receives internal notifications (contact form submissions, etc.).
# Defaults to cookie-bite@cookie-bite.com if not set.
CONTACT_INBOX=cookie-bite@cookie-bite.com

# Verified Resend domain — used for diagnostics + logo URL fallback.
RESEND_DOMAIN=cookie-bite.com
# Optional: segment for new contacts (Resend Dashboard → Segments)
# RESEND_SEGMENT_ID=
# Legacy audiences API (deprecated — prefer segments)
# RESEND_AUDIENCE_ID=

# Optional: override the brand logo URL used in email headers. By default we
# build it from `${NEXT_PUBLIC_APP_URL}/brand/logo-mark.svg`. Set this to a
# PNG instead (e.g. via CDN) if Outlook fallback matters for your audience.
# NEXT_PUBLIC_EMAIL_LOGO_URL=https://cookie-bite.com/brand/logo-mark.png

# === Python microservices (optional — cookie-bite-python/) ================
# Local: http://127.0.0.1:8000 after `npm run python:up`
# Browser calls /api/python/* (Next rewrites to PYTHON_API_URL).
PYTHON_API_URL=http://127.0.0.1:8000
# Python .env also needs CLERK_JWKS_URL (Clerk Dashboard → JWT template / JWKS URL)

# === Email automation (queue, fallback, self-heal) ==========================
EMAIL_AUTOMATION_ENABLED=true
EMAIL_USE_QUEUE=true
EMAIL_USE_DB_QUEUE=true
EMAIL_PROVIDER_PRIORITY=resend,smtp,sendgrid,mailgun
EMAIL_HEALTH_TEST_TO=
# Encrypt SMTP passwords in smtp_configs (openssl rand -hex 32)
# EMAIL_CONFIG_ENCRYPTION_KEY=
# SMTP fallback (Gmail/Outlook/custom) — Hostinger example (port 465 = SSL):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=cookie-bite@cookie-bite.com
# SMTP_PASS=<mailbox-password-from-hostinger>
# SMTP_FROM=cookie-bite@cookie-bite.com
# SMTP_FROM_NAME=Cookie Bite
# IMAP (inbox only — not used by the app): imap.hostinger.com:993
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_FROM_EMAIL=

# === Internal APIs & ISR ==================================================
# Random hex (e.g. openssl rand -hex 32). Used by cron + internal routes.
INTERNAL_API_SECRET=<random-secret-for-internal-routes>
# POST /api/revalidate — header x-revalidate-secret (required in production).
REVALIDATE_SECRET=<random-secret-for-on-demand-revalidate>
# Audit + Hostinger import template: npm run hostinger:env-audit

# === AI — Mrs. Cookie (admin) + Mr. Brownie (storefront) ==================
# Server-only. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>
# Optional — shared by admin copilot + Mr. Brownie (default: gemini-flash-latest)
MR_BROWNIE_GEMINI_MODEL=gemini-flash-latest

# === First-party tracking system ==========================================
# Optional shared secret between SDK and /api/track (prevents spoofed events).
# If set, the SDK must be configured with `token` and the server requires
# `x-tracking-token: <value>` on every batch.
TRACKING_TOKEN=
NEXT_PUBLIC_TRACKING_TOKEN=
# Set to 1 to disable client-side tracking (previews, staff devices).
NEXT_PUBLIC_DISABLE_TRACKING=
# Optional — OpenAI fallback for /api/analytics/insights (Gemini is used first)
OPENAI_INSIGHTS_MODEL=gpt-4o-mini

# === Sanity CMS (blog / content) ===========================================
# NEXT_PUBLIC_SANITY_PROJECT_ID=<your-project-id>
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_WEBHOOK_SECRET=<revalidate-webhook-secret>

# === Admin bootstrap ======================================================
# Used by `scripts/supabase-bootstrap-owner.mjs` to seed the first owner.
# This is SEPARATE from the customer-care inbox above.
OWNER_BOOTSTRAP_EMAIL=cookie-bite@cookie-bite.com
