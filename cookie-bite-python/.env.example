# Cookie Bite Python microservices — copy to cookie-bite-python/.env
# Never commit .env (parent .gitignore covers .env*)

APP_ENV=development
SECRET_KEY=change-me-local-only

# Same Supabase project as Next.js
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres (Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

REDIS_URL=redis://redis:6379/0

# Must match Next.js INTERNAL_API_SECRET for service-to-service calls
INTERNAL_API_SECRET=your-internal-api-secret

# Clerk JWT verification (Dashboard → API Keys → show JWT issuer / JWKS)
# Example: https://skilled-horse-43.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json

ALLOWED_ORIGINS=http://localhost:3000,https://cookie-bite.com

# Phase 3+ (optional)
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
