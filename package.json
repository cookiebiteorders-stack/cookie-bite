{
  "name": "cookie-bite",
  "version": "0.1.0",
  "private": true,
  "main": "server.mjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "node server.mjs",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage=false",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "deploy:github": "node scripts/git-sync.mjs",
    "email:check": "node scripts/email-diagnostics.mjs",
    "email:finalize-dns": "node scripts/resend-dns-finalize.mjs",
    "copilot:check": "node scripts/copilot-check.mjs",
    "hostinger:export-gemini-env": "node scripts/hostinger-export-gemini-env.mjs",
    "hostinger:env-audit": "node scripts/hostinger-production-env-audit.mjs",
    "hostinger:checklist": "node scripts/hostinger-sync-checklist.mjs",
    "supabase:list-migrations": "node scripts/supabase-list-migrations.mjs",
    "supabase:migrate": "node scripts/supabase-run-migrations.mjs",
    "supabase:fix-auth-users-exposed": "node scripts/supabase-fix-auth-users-exposed.mjs",
    "supabase:ensure-schema": "node scripts/supabase-ensure-schema.mjs",
    "supabase:check-schema": "node scripts/supabase-schema-snapshot-check.mjs",
    "supabase:healthcheck": "node scripts/supabase-full-healthcheck.mjs",
    "whatsapp:bridge:extract": "node scripts/extract-whatsapp-bridge.mjs",
    "whatsapp:bridge": "npm --prefix services/whatsapp-bridge start",
    "security:audit": "node scripts/security-audit.mjs",
    "security:rotate-plan": "node scripts/rotate-secrets-checklist.mjs",
    "backup:supabase": "node scripts/supabase-backup.mjs",
    "backup:supabase:restore": "node scripts/supabase-restore.mjs",
    "python:up": "docker compose -f cookie-bite-python/docker-compose.yml up --build",
    "python:down": "docker compose -f cookie-bite-python/docker-compose.yml down",
    "python:retrain": "node scripts/python-retrain.mjs"
  },
  "dependencies": {
    "@clerk/localizations": "^4.6.0",
    "@clerk/nextjs": "^7.3.1",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@sanity/client": "^7.22.0",
    "@sanity/vision": "^5.24.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "@tanstack/react-table": "^8.21.3",
    "@types/pdfkit": "^0.17.6",
    "bullmq": "^5.76.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.24",
    "next": "16.2.4",
    "next-cloudinary": "^6.17.5",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.2",
    "sanity": "^5.24.0",
    "svix": "^1.92.2",
    "tailwind-merge": "^3.3.1",
    "three": "^0.184.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "typescript": "^5"
  }
}
